{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jib-preorder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jib-preorder",
      "database_id": "c82757aa-e73b-4aac-88ea-2c361eab2fcd",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
